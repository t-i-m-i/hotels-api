PORT=3000

# Same Postgres database (Neon) as hotels-alt-api — both APIs read/write the
# same `hotels` table. Use the pooled connection string from Neon.
DATABASE_URL=postgres://user:password@host/dbname

# Redis connection for job queues (email confirmation, invoice generation).
# Run `docker compose up -d redis` for local dev.
REDIS_URL=redis://localhost:6379

# Resend API key for sending booking confirmation emails. Get one at
# https://resend.com/api-keys. Leave unset in dev to have the email job
# log-and-skip instead of throwing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BetterAuth session/cookie signing secret. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Base URL this API is served from (used to build auth callback/redirect URLs).
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App credentials for "Sign in with GitHub". Create one at
# https://github.com/settings/developers ("New OAuth App") with:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Firebase Cloud Messaging (push notifications on booking status change).
# From a Firebase service account key: Firebase console > Project settings
# > Service accounts > "Generate new private key" (downloads a JSON file).
# Leave unset in dev to have push sends log-and-skip instead of throwing.
#   FIREBASE_PROJECT_ID    <- the JSON file's "project_id"
#   FIREBASE_CLIENT_EMAIL  <- the JSON file's "client_email"
#   FIREBASE_PRIVATE_KEY   <- the JSON file's "private_key", keep the \n
#                             escape sequences as-is (don't turn them into
#                             real newlines in this file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
