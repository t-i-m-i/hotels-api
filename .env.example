PORT=3000

# Same Postgres database (Neon) as hotels-alt-api — both APIs read/write the
# same `hotels` table. Use the pooled connection string from Neon.
DATABASE_URL=postgres://user:password@host/dbname

# Redis connection for job queues (email confirmation, invoice generation).
# Run `docker compose up -d redis` for local dev.
REDIS_URL=redis://localhost:6379

# Resend API key for sending booking confirmation emails. Get one at
# https://resend.com/api-keys. Leave unset in dev to have the email job
# log-and-skip instead of throwing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BetterAuth session/cookie signing secret. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Base URL this API is served from (used to build auth callback/redirect URLs).
BETTER_AUTH_URL=http://localhost:3000
