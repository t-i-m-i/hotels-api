  "info": {
    "title": "Hotels API",
    "description": "Public API contract for the Hotels app",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "GeoDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "example": 41.3851,
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "example": 2.1734,
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "HotelDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Hotel Barcino Central"
          },
          "description": {
            "type": "string",
            "example": "A boutique hotel steps away from Las Ramblas, blending Gothic Quarter charm with modern comfort."
          },
          "location": {
            "type": "string",
            "example": "Barcelona, Spain"
          },
          "geo": {
            "$ref": "#/components/schemas/GeoDto"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "location",
          "geo"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "hotelId": {
            "type": "string",
            "example": "38dca5bd-0417-4971-baee-056e1aa3ce21"
          },
          "checkIn": {
            "type": "string",
            "example": "2026-09-01"
          },
          "checkOut": {
            "type": "string",
            "example": "2026-09-10"
          }
        },
        "required": [
          "hotelId",
          "checkIn",
          "checkOut"
        ]
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "38dca5bd-0417-4971-baee-056e1aa3ce21"
          },
          "userId": {
            "type": "string",
            "example": "bf721a73-1a8b-4de2-b74b-a747e1197d3f"
          },
          "hotelId": {
            "type": "string",
            "example": "38dca5bd-0417-4971-baee-056e1aa3ce21"
          },
          "checkIn": {
            "type": "string",
            "example": "2026-09-01"
          },
          "checkOut": {
            "type": "string",
            "example": "2026-09-10"
          }
        },
        "required": [
          "id",
          "userId",
          "hotelId",
          "checkIn",
          "checkOut"
        ]
      },
      "BookingHotelSummaryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "BookingUserSummaryDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName"
        ]
      },
      "BookingDetailsDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "hotel": {
            "$ref": "#/components/schemas/BookingHotelSummaryDto"
          },
          "user": {
            "$ref": "#/components/schemas/BookingUserSummaryDto"
          },
          "checkIn": {
            "type": "string"
          },
          "checkOut": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "hotel",
          "user",
          "checkIn",
          "checkOut"
        ]
      },
      "UpdateBookingDto": {
        "type": "object",
        "properties": {
          "hotelId": {
            "type": "string",
            "example": "38dca5bd-0417-4971-baee-056e1aa3ce21"
          },
          "checkIn": {
            "type": "string",
            "example": "2026-09-01"
          },
          "checkOut": {
            "type": "string",
            "example": "2026-09-10"
          }
        }
      }
    }
  }
}