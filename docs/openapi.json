{
  "openapi": "3.0.0",
  "paths": {
    "/hotels": {
      "get": {
        "operationId": "HotelsController_findAll",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Case-insensitive filter matched against name and location",
            "schema": {
              "example": "Barcelona",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HotelDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "hotels"
        ]
      }
    },
    "/hotels/{id}": {
      "get": {
        "operationId": "HotelsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelDto"
                }
              }
            }
          },
          "404": {
            "description": "Hotel with the given id does not exist"
          }
        },
        "tags": [
          "hotels"
        ]
      }
    },
