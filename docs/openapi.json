          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingDetailsDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "bookings"
