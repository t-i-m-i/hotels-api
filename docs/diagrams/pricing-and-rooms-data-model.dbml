enum booking_status {
  pending
  confirmed
  cancelled
  completed
  no_show
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

Table roles {
  id   smallint [pk]
  name text [not null, unique, note: 'seed: admin (1), guest (2), host (3)']
}

Table users {
  id         uuid [pk, default: `gen_random_uuid()`]
  first_name text [not null]
  last_name  text [not null]
  email      text [not null, unique]
  role_id    smallint [not null, ref: > roles.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table hotels {
  id           uuid [pk, default: `gen_random_uuid()`, note: 'existing table was recreated as uuid in migration 1786732681347']
  name         text [not null]
  description  text [not null]
  location     text [not null, note: 'remove later - redundand']
  latitude     float8 [not null]
  longitude    float8 [not null]
  city text [note: 'normalize later']
  country text [note: 'normalize later']
  owner_id uuid [ref: > users.id, note: 'the host who owns the listing (users.role_id -> host)']
  currency     char(3) [not null, default: 'EUR', note: 'ISO 4217; every money value for this hotel is in this currency']
  timezone     text [not null, default: 'UTC', note: 'IANA tz; needed to resolve "today" / check-in boundaries']
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]
}

Table room_types {
  id              uuid [pk, default: `gen_random_uuid()`]
  hotel_id        uuid [not null, ref: > hotels.id]
  name            text [not null, note: 'e.g. "Deluxe King"']
  description     text
  max_occupancy   int [not null, note: 'hard cap; validates bookings.guests']
  base_occupancy  int [not null, default: 1, note: 'guests included before per-guest pricing applies']
  units           int [not null, default: 1, note: 'inventory: how many physical rooms of this type exist']
  base_price      numeric(12,2) [not null, note: 'nightly rate when no rate_period matches']
  price_per_guest bool [not null, default: false, note: 'default policy; a rate_period may override per window']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes {
    (hotel_id, name) [unique]
  }
}

Table rate_periods {
  id              uuid [pk, default: `gen_random_uuid()`]
  room_type_id    uuid [not null, ref: > room_types.id]
  name            text [note: 'e.g. "High season 2026"']
  starts_on       date [not null]
  ends_on         date [not null, note: 'EXCLUSIVE: prices night N when starts_on <= N < ends_on']
  price           numeric(12,2) [not null]
  price_per_guest bool [not null, default: false]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes {
    (room_type_id, starts_on)
  }
  Note: 'Overrides only. The "one price for any period" case is room_types.base_price. Migration adds an EXCLUDE USING gist no-overlap constraint.'
}

Table bookings {
  id             uuid [pk, default: `gen_random_uuid()`]
  reference      text [not null, unique, note: 'human-facing confirmation code, e.g. BK-7F3K2Q']
  hotel_id       uuid [not null, ref: > hotels.id]
  room_type_id   uuid [not null, ref: > room_types.id]
  rate_period_id uuid [ref: > rate_periods.id, note: 'provenance only; nullable; ON DELETE SET NULL; never read for money']

  guest_id       uuid [not null, ref: > users.id, note: 'the guest who booked (users.role_id -> guest); existing column is named user_id']
  guest_name     text [not null, note: 'snapshot of the guest name at booking time']
  guest_email    text [not null, note: 'snapshot of the guest email at booking time']

  check_in       date [not null]
  check_out      date [not null, note: 'EXCLUSIVE; nights = check_out - check_in; CHECK (check_out > check_in)']
  guests         int [not null, note: 'CHECK (guests BETWEEN 1 AND room_types.max_occupancy at booking time)']
  status         booking_status [not null, default: 'pending']
  is_synthetic   bool [not null, default: false, note: 'load-test / e2e bookings, so cleanup can bulk-remove them']

  // ---- price snapshot, frozen at booking time ----
  currency        char(3) [not null]
  price_per_guest bool [not null]
  nightly_rate    numeric(12,2) [not null, note: 'representative rate; booking_nights holds the exact per-night breakdown']
  room_subtotal   numeric(12,2) [not null, note: 'sum over nights of nightly_rate * (price_per_guest ? guests : 1)']
  taxes_total     numeric(12,2) [not null, default: 0]
  total_price     numeric(12,2) [not null, note: 'room_subtotal + taxes_total']

  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    (room_type_id, check_in)
  }
  Note: 'No double-booking: units = 1 -> partial EXCLUDE constraint; units > 1 -> service checks overlapping active bookings < room_types.units.'
}

Table booking_nights {
  booking_id     uuid [not null, ref: > bookings.id]
  night          date [not null]
  nightly_rate   numeric(12,2) [not null]
  rate_period_id uuid [ref: > rate_periods.id]

  indexes {
    (booking_id, night) [pk]
  }
  Note: 'One row per stayed night with the rate that applied. room_subtotal = sum over these rows.'
}

Table payment_methods {
  id        smallint [pk]
  name      text [not null, unique, note: 'seed: card (1), paypal (2), bank_transfer (3), cash_on_arrival (4)']
  is_active bool [not null, default: true, note: 'hide a method from checkout without deleting history']
}

Table payments {
  id         uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  method_id  smallint [not null, ref: > payment_methods.id]
  status     payment_status [not null, default: 'pending']
  amount     numeric(12,2) [not null, note: 'snapshot of bookings.total_price at charge time']
  currency   char(3) [not null]
  paid_at    timestamptz [note: 'set when status -> paid; null otherwise']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (booking_id)
  }
  Note: '''
  Demo only, no real provider. The "Pay now" stub screen inserts one row and immediately
  sets status = paid, paid_at = now(); the booking then moves to confirmed.
  Modelled as its own table (not columns on bookings) so a booking can carry a retry or a
  refund row later without reshaping anything. Happy path is exactly one row per booking.
  '''
}
